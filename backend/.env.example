# AARYX backend configuration.
# Copy this file to `backend/.env` and edit. `.env` is git-ignored: never commit real keys.
# Every setting has a safe default, so an empty `.env` also works for local Ollama use.

# --- Application ------------------------------------------------------------------
APP_NAME=AARYX
# development | production | test | staging
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Keep 127.0.0.1 so the API is reachable only from this computer.
API_HOST=127.0.0.1
API_PORT=8000

# --- AI routing -------------------------------------------------------------------
# local | cloud
AI_MODE=local
# ollama | openai | anthropic | gemini
AI_PROVIDER=ollama
# Fall back to a second provider when the first fails.
AI_FALLBACK_ENABLED=false
# openai | anthropic | gemini (needs the matching API key below)
AI_FALLBACK_PROVIDER=
AI_MAX_RETRIES=1
# Explicit consent to send conversations to a cloud provider when local Ollama fails.
# Leave false to keep everything on this computer.
AI_ALLOW_CLOUD_FALLBACK=false

# --- Local model (Ollama) ---------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=180.0

# --- Generic cloud endpoint (OpenAI-compatible, optional) -------------------------
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# --- OpenAI (optional, used when AI_PROVIDER=openai or as fallback) ----------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60.0

# --- Anthropic (optional, used when AI_PROVIDER=anthropic or as fallback) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=60.0

# --- Google Gemini (optional, used when AI_PROVIDER=gemini or as fallback) ---------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60.0

# --- Conversations and long-term memory (local SQLite) ------------------------------
# false = no conversation history and no memory at all.
MEMORY_ENABLED=true
MEMORY_DATABASE_URL=sqlite+aiosqlite:///./data/aaryx.db
# Past messages sent to the model with each request.
MEMORY_MAX_HISTORY_MESSAGES=20
# Local Ollama model that proposes memory suggestions (never a cloud model).
MEMORY_EXTRACTION_MODEL=qwen3.5:4b
# Approved memories added to each prompt (0 = never add memories to prompts).
MEMORY_MAX_CONTEXT_ITEMS=8
# true = AARYX may suggest memories from conversation; you approve or reject each one.
# false = only "remember that ..." requests create memories.
MEMORY_SUGGESTIONS_ENABLED=true
# Suggestions below this confidence (0.0-1.0) are discarded.
MEMORY_CANDIDATE_MIN_CONFIDENCE=0.60
