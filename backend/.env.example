APP_NAME=AARYX
APP_ENV=development
AI_MODE=local
AI_PROVIDER=ollama
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=
AI_MAX_RETRIES=1
AI_ALLOW_CLOUD_FALLBACK=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=180.0
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# OpenAI Settings (optional, used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60.0

# Anthropic Settings (optional, used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=60.0

# Google Gemini Settings (optional, used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60.0

# Memory & Conversation Persistence (Local-first SQLite)
MEMORY_ENABLED=true
MEMORY_DATABASE_URL=sqlite+aiosqlite:///./data/aaryx.db
MEMORY_MAX_HISTORY_MESSAGES=20
